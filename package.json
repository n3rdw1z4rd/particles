{
  "name": "particles",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "docker-clean": "docker images | grep particles | awk '{print $3}' | xargs docker rmi",
    "docker-build": "docker build -t particles .",
    "docker-run": "docker run -d -p 4000:4000 --restart unless-stopped --name particles particles",
    "docker-update":"docker rm -f particles && npm run docker-clean && npm run docker-build && npm run docker-run"
  },
  "keywords": [],
  "author": "@n3rdw1z4rd",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/three": "^0.175.0",
    "typescript": "^5.8.3",
    "vite": "^6.2.6"
  },
  "dependencies": {
    "lil-gui": "^0.20.0",
    "simplex-noise": "^4.0.3",
    "three": "^0.175.0"
  }
}
