{
    "name": "particles",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build",
        "preview": "vite preview",
        "docker-clean": "docker images | grep particles | awk '{print $3}' | xargs docker rmi",
        "docker-build": "docker build -t particles .",
        "docker-run": "docker run -d -p 4000:80 --restart unless-stopped --name particles particles",
        "docker-update": "docker rm -f particles && npm run docker-clean && npm run docker-build && npm run docker-run"
    },
    "keywords": [],
    "author": "@n3rdw1z4rd",
    "license": "MIT",
    "devDependencies": {
        "@types/node": "^24.1.0",
        "@types/three": "^0.178.1",
        "@vitejs/plugin-basic-ssl": "^2.1.0",
        "typescript": "^5.8.3",
        "vite": "^6.3.2"
    },
    "dependencies": {
        "three": "^0.179.1"
    }
}
